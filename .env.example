# Variables de identity (valores por defecto = desarrollo local).
DB_URL=localhost
DB_USERNAME=tripbus
DB_PASSWORD=tripbus_local_pw
REDIS_HOST=localhost
# Llaves RSA (PKCS#8) con las que se firman los JWT. Sin ellas solo arranca con el perfil "local".
JWT_PRIVATE_KEY_PATH=/keys/private.pem
JWT_PUBLIC_KEY_PATH=/keys/public.pem
JWT_EXPIRATION_MINUTES=60
# Usuarios de demostración: admin@, operador@, conductor@, pasajero@tripbus.co
DEMO_USERS_ENABLED=true
DEMO_USERS_PASSWORD=TripBus2026
