# Variables de identity con valores de QA LOCAL (no son secretos reales).
# Uso: cp .env.example .env   (el .env nunca se sube a git). En PROD los secretos viven solo en el servidor.

# --- Servicio ---
SERVER_PORT=18001

# --- PostgreSQL propia de identity (en Docker el compose cambia host/puerto a identity-db:5432) ---
DB_HOST=localhost
DB_PORT=18101
DB_NAME=tripbus_identity
DB_USERNAME=identity
DB_PASSWORD=identity_qa_pw

# --- Redis compartido, con contraseña (en Docker: redis:6379) ---
REDIS_HOST=localhost
REDIS_PORT=18100
REDIS_PASSWORD=tripbus_redis_qa_pw

# --- JWT: llaves RSA (PKCS#8) generadas por el servicio jwt-keys del compose ---
JWT_PRIVATE_KEY_PATH=/keys/private.pem
JWT_PUBLIC_KEY_PATH=/keys/public.pem
JWT_EXPIRATION_MINUTES=60

# --- Usuarios de demostración (solo QA): admin@, operador@, conductor@, pasajero@tripbus.co ---
DEMO_USERS_PASSWORD=TripBus2026

# Copia este archivo a .env (o exporta las variables en tu shell / orquestador) y completa los
# valores. NINGUNO de estos secretos debe tener un valor literal en el repositorio.

# --- Base de datos ---
DB_URL=localhost
DB_USERNAME=tripbus
# Sin valor por defecto en los perfiles demo/production (ver application-demo.yml /
# application-production.yml): si falta, el arranque falla explícitamente.
DB_PASSWORD=tripbus_local_pw

# --- Llaves JWT (RS256) ---
# Rutas a un par de llaves RSA en PEM (PKCS8 la privada, X.509 la publica). En local/test, si se
# dejan vacias, JwtKeyProvider genera un par EFIMERO en memoria; en demo/production es obligatorio
# montarlas como secreto y fallara el arranque si faltan.
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=
JWT_KEY_ID=identity-key-1
JWT_EXPIRATION_MINUTES=60

# --- Cifrado en reposo (US-089) ---
# Llave AES-256 en base64 (32 bytes) para EncryptionKeyProvider / DocumentoIdentidadConverter.
# En local/test, si se deja vacia, se genera una llave EFIMERA en memoria (los datos cifrados no
# sobreviven a un reinicio). En demo/production es obligatoria: el arranque falla si falta o si no
# decodifica a exactamente 32 bytes. Generarla, por ejemplo, con:
#   openssl rand -base64 32
IDENTITY_ENCRYPTION_KEY=

# --- Perfil activo ---
# local | test | demo | production
SPRING_PROFILES_ACTIVE=local

# --- Argon2id (hashing de contraseñas) ---
ARGON2_SALT_LENGTH=16
ARGON2_HASH_LENGTH=32
ARGON2_PARALLELISM=1
ARGON2_MEMORY=19456
ARGON2_ITERATIONS=2